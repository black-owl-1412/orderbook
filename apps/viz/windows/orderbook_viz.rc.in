// Windows resources for orderbook_viz.exe: icon and version information.
// Configured by CMake (configure_file) into the build tree.
#include <winver.h>

// GLFW uses the resource named GLFW_ICON for the window and taskbar icon, and Explorer
// shows the first icon in the file, so one resource covers both.
GLFW_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/apps/viz/windows/orderbook.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Order book viewer"
            VALUE "ProductName", "Orderbook"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "orderbook_viz"
            VALUE "OriginalFilename", "orderbook_viz.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

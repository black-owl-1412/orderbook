# embed_files(<output.cpp> <namespace> <name> <file> [<name> <file> ...])
#
# Writes a C++ source file that holds each <file> as a byte array, so a program can
# carry its assets (here: the viewer's font) inside the executable instead of loading
# them from a path that only exists on the build machine. For every pair it defines
#
#     namespace <namespace> {
#     extern const unsigned char <name>[];
#     extern const std::size_t <name>Size;
#     }
#
# The output is regenerated whenever one of the input files changes.
function(embed_files output namespace)
  set(pairs ${ARGN})
  list(LENGTH pairs count)
  math(EXPR odd "${count} % 2")
  if(count EQUAL 0 OR odd)
    message(FATAL_ERROR "embed_files: expected <name> <file> pairs")
  endif()

  set(body "")
  set(inputs "")
  math(EXPR last "${count} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET pairs ${i} name)
    list(GET pairs ${j} file)
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "embed_files: ${file} does not exist")
    endif()
    list(APPEND inputs "${file}")
    file(READ "${file}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    # 0xNN, for every byte, 16 per line. (CMake regexes have no {n} repetition, so the
    # 16-byte pattern is spelled out.)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 16 sixteen)
    string(REGEX REPLACE "(${sixteen})" "\\1\n" bytes "${bytes}")
    string(APPEND body "alignas(4) extern const unsigned char ${name}[] = {\n${bytes}\n};\n")
    string(APPEND body "extern const std::size_t ${name}Size = ${size};\n\n")
  endforeach()

  set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#include <cstddef>\n\nnamespace ${namespace} {\n\n${body}}  // namespace ${namespace}\n")
  # Only rewrite when the content changes, so the file is not rebuilt on every configure.
  if(EXISTS "${output}")
    file(READ "${output}" previous)
  endif()
  if(NOT content STREQUAL previous)
    file(WRITE "${output}" "${content}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${inputs})
endfunction()
